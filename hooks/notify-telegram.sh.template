#!/bin/bash
# Notification hook: Send permission prompts and idle notifications to Telegram.
# Reads hook event data from stdin.
#
# Credentials are read from config.yaml at RUNTIME — nothing secret is baked
# into this script. The first bot_token/owner_id in the file belong to the
# telegram: block (discord/slack tokens appear later in config.example.yaml's
# layout, so `head -1` picks the right one).

AGENT_ROOT="{{AGENT_ROOT}}"
CONFIG="$AGENT_ROOT/config.yaml"

# Extract a scalar config value: handles double/single-quoted and unquoted
# forms, strips trailing comments and whitespace (an unquoted hand-edited
# value like `bot_token: 123:ABC  # prod` must not capture the comment).
_cfg_value() {
  sed -n "s/^[[:space:]]*$1:[[:space:]]*//p" "$CONFIG" 2>/dev/null | head -1 \
    | sed -e 's/^"\([^"]*\)".*$/\1/' \
          -e "s/^'\([^']*\)'.*\$/\1/" \
          -e 's/[[:space:]]*#.*$//' \
          -e 's/[[:space:]]*$//'
}

BOT_TOKEN=$(_cfg_value bot_token)
OWNER_ID=$(_cfg_value owner_id)
case "$OWNER_ID" in (*[!0-9]*|"") OWNER_ID="" ;; esac
if [ -z "$BOT_TOKEN" ] || [ -z "$OWNER_ID" ] || [ "$BOT_TOKEN" = "YOUR_BOT_TOKEN" ]; then
  exit 0
fi

PENDING_DIR="$AGENT_ROOT/pending-approvals"
mkdir -p "$PENDING_DIR"

INPUT=$(cat)

TYPE=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('notification_type',''))" 2>/dev/null)
CWD=$(echo "$INPUT" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('cwd',''))" 2>/dev/null)

# Scope to this agent's tree. Canonicalize both sides — a symlinked agent
# root or --agent-dir would otherwise never match and silently disable all
# notifications.
CWD_REAL=$(readlink -f "$CWD" 2>/dev/null || echo "$CWD")
ROOT_REAL=$(readlink -f "$AGENT_ROOT" 2>/dev/null || echo "$AGENT_ROOT")
case "$CWD_REAL" in
  "$ROOT_REAL"|"$ROOT_REAL"/*) ;;
  *) exit 0 ;;
esac

# Find the tmux session whose pane runs in that directory — works for ANY
# configured cc_agent (workspace, code, research...), not a hardcoded name.
# Tab-separated + per-pane canonicalization so paths with spaces or symlinks
# match. No matching pane means this isn't a tmux-driven agent (the bot's
# own claude -p invocations, or a plain interactive session) — stay quiet.
TMUX_SESSION=""
while IFS="$(printf '\t')" read -r sess path; do
  [ -n "$path" ] || continue
  if [ "$(readlink -f "$path" 2>/dev/null || echo "$path")" = "$CWD_REAL" ]; then
    TMUX_SESSION="$sess"
    break
  fi
done <<EOF_PANES
$(tmux list-panes -a -F "#{session_name}$(printf '\t')#{pane_current_path}" 2>/dev/null)
EOF_PANES
[ -z "$TMUX_SESSION" ] && exit 0
AGENT="$TMUX_SESSION"

case "$TYPE" in
  permission_prompt)
    # Brief settle so we don't capture before Claude finishes drawing the prompt.
    sleep 0.4
    PANE_CONTENT=$(tmux capture-pane -t "$TMUX_SESSION" -p -S -20 2>/dev/null)
    QUESTION=$(echo "$PANE_CONTENT" | grep "Do you want to" | tail -1)
    COMMAND=$(echo "$PANE_CONTENT" | grep -A1 "Bash command\|command:" | tail -1 | sed 's/^[[:space:]]*//')
    HAS_PERSISTENT=$(echo "$PANE_CONTENT" | grep -c "don't ask again")

    # If we can't see an actual prompt, this is a stale or auto-resolved
    # notification (common under --dangerously-skip-permissions). Suppress
    # rather than wake the user for a non-decision.
    if [ -z "$QUESTION" ] && [ -z "$COMMAND" ]; then
      exit 0
    fi

    APPROVAL_ID="approval-$(date +%s)-$$"
    cat > "$PENDING_DIR/${APPROVAL_ID}.json" <<EOF
{"id":"$APPROVAL_ID","session":"$TMUX_SESSION","question":"$(echo "$QUESTION" | sed 's/"/\\"/g')","command":"$(echo "$COMMAND" | sed 's/"/\\"/g')","has_persistent":$HAS_PERSISTENT,"timestamp":"$(date -Iseconds)"}
EOF

    MSG="🔐 *Permission Request*%0AAgent: \`$AGENT\`%0A"
    [ -n "$COMMAND" ] && MSG+="Command: \`$(echo "$COMMAND" | head -c 200)\`%0A"
    MSG+="$QUESTION%0A%0A/approve $APPROVAL_ID%0A"
    [ "$HAS_PERSISTENT" -gt 0 ] && MSG+="/approve_always $APPROVAL_ID%0A"
    MSG+="/deny $APPROVAL_ID"
    curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
      -d "chat_id=${OWNER_ID}" -d "text=${MSG}" -d "parse_mode=Markdown" > /dev/null 2>&1 &
    ;;
  idle_prompt)
    MSG="✅ *${AGENT}* finished and is idle"
    curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
      -d "chat_id=${OWNER_ID}" -d "text=${MSG}" -d "parse_mode=Markdown" > /dev/null 2>&1 &
    ;;
esac
exit 0
